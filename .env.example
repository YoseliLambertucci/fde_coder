# Copiá este archivo como ".env" y completá los valores. NUNCA subas el ".env" a GitHub.

# Proveedor del modelo: groq | anthropic | ollama
#   groq      -> openai/gpt-oss-120b (modelo de OpenAI servido por Groq, API compatible con OpenAI). Es el usado en la PE2.
#   anthropic -> Claude (de pago)
#   ollama    -> local en tu PC (sin clave)
PROVEEDOR=groq

# Solo se completa la clave del proveedor elegido
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Opcionales: si se dejan vacíos se usan el modelo y los precios por defecto del proveedor
MODELO=
# Precios en USD por millón de tokens (verificar en la página oficial del proveedor)
PRECIO_ENTRADA_USD_MTOK=
PRECIO_SALIDA_USD_MTOK=

# PE3 (RAG) - opcionales
# Configuración de fragmentado por defecto: A (500/50) o B (1000/150). Cambiar según el resultado de medir_rag.py
FRAGMENTADO=A
# onnx = modelo real de embeddings (por defecto). hash = solo para pruebas rápidas sin descargar nada
EMBEDDER=onnx
